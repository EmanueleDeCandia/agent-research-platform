# Research Radar — runtime configuration
# Copy to .env and adjust. Never commit real secrets.

# OpenAI (required unless DEMO_MODE=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# HTTP server
PORT=8787

# Research budgets (PRD §17: maximum tool/research iteration budget)
RR_MAX_MODEL_TURNS=12
RR_MAX_TOOL_CALLS=24

# External call timeout (ms)
RR_HTTP_TIMEOUT_MS=120000

# Demo mode: scripted model client for UI preview without an API key.
# Clearly labeled in the UI. The real OpenAI path is the default.
DEMO_MODE=false
