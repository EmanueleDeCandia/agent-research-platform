# Research Radar — runtime configuration
# Copy to .env and adjust. Never commit real secrets.

# OpenAI (required unless DEMO_MODE=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# CORDIS — Innovation Intelligence (Milestone 2).
# The adapter uses the official CORDIS Data Extractions API, which requires a
# free API key (request it via the CORDIS helpdesk: cordis@publications.europa.eu).
# Without a key (and outside demo mode) innovation retrieval stays disabled.
CORDIS_API_KEY=
CORDIS_ENABLED=true
# CORDIS_BASE_URL=https://cordis.europa.eu
# CORDIS_MAX_RESULTS=20

# EU Policy Intelligence (Milestone 3) - CELLAR public SPARQL endpoint.
# No key required; covers EUR-Lex documents (CELEX is the canonical id).
POLICY_ENABLED=true
# CELLAR_BASE_URL=https://publications.europa.eu/sparql
# CELLAR_MAX_RESULTS=20

# HTTP server
PORT=8787

# Research budgets (PRD §17: maximum tool/research iteration budget)
RR_MAX_MODEL_TURNS=12
RR_MAX_TOOL_CALLS=24

# External call timeout (ms)
RR_HTTP_TIMEOUT_MS=120000

# Demo mode: scripted model client + fixture CORDIS adapter for UI preview
# without any API key. Clearly labeled in the UI. The real path is the default.
DEMO_MODE=false
